{
  "$schema": "https://turborepo.dev/schema.json",
  "globalEnv": ["API_INTERNAL_ORIGIN"],
  "tasks": {
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "check-types": {
      "cache": false,
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "@instagram/contracts#test": {
      "dependsOn": ["build"],
      "cache": false
    },
    "@instagram/api#db:generate": {
      "cache": false
    },
    "@instagram/api#build": {
      "dependsOn": ["^build", "@instagram/api#db:generate"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "@instagram/api#lint": {
      "dependsOn": ["^build", "@instagram/api#db:generate"]
    },
    "@instagram/api#check-types": {
      "cache": false,
      "dependsOn": ["^build", "@instagram/api#db:generate"]
    },
    "@instagram/api#test": {
      "dependsOn": ["^build", "@instagram/api#db:generate"],
      "cache": false
    }
  }
}
