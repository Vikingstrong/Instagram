
{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "lint": {},
    "check-types": {
      "cache": false,
      "dependsOn": ["^build"]
    },
    "test": {
      "cache": false
    },
    "test:e2e": {
      "cache": false
    }
  }
}
