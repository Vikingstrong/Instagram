generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum AuthTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum FollowStatus {
  PENDING
  ACCEPTED
}

enum MediaKind {
  POST
  AVATAR
}

enum MediaState {
  PENDING
  READY
  DELETED
}

model User {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email             String        @db.VarChar(254)
  emailKey          String        @unique @db.VarChar(254)
  username          String        @db.VarChar(30)
  usernameKey       String        @unique @db.VarChar(30)
  passwordHash      String        @db.Text
  emailVerifiedAt   DateTime?     @db.Timestamptz(3)
  credentialVersion Int           @default(0)
  displayName       String        @default("") @db.VarChar(30)
  // Unicode lower case computed by the API: search must not depend on the
  // database collation ("C" folds only ASCII).
  displayNameKey    String        @default("") @db.Text
  bio               String        @default("") @db.VarChar(150)
  isPrivate         Boolean       @default(false)
  avatarMediaId     String?       @unique @db.Uuid
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime      @default(now()) @updatedAt @db.Timestamptz(3)
  sessions          AuthSession[]
  tokens            AuthToken[]
  following         Follow[]      @relation("follower")
  followers         Follow[]      @relation("followee")
  avatar            Media?        @relation("avatar", fields: [avatarMediaId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  media             Media[]       @relation("owner")
  posts             Post[]
  likes             PostLike[]
  comments          Comment[]

  @@map("auth_users")
}

model AuthSession {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String    @db.Uuid
  tokenHash         String    @unique @db.VarChar(64)
  credentialVersion Int
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt         DateTime  @db.Timestamptz(3)
  revokedAt         DateTime? @db.Timestamptz(3)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model AuthToken {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String           @db.Uuid
  purpose           AuthTokenPurpose
  tokenHash         String           @unique @db.VarChar(64)
  credentialVersion Int
  createdAt         DateTime         @default(now()) @db.Timestamptz(3)
  expiresAt         DateTime         @db.Timestamptz(3)
  consumedAt        DateTime?        @db.Timestamptz(3)
  revokedAt         DateTime?        @db.Timestamptz(3)
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  delivery          MailDelivery?

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("auth_tokens")
}

model MailDelivery {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tokenId        String    @unique @db.Uuid
  payload        String?   @db.Text
  attempts       Int       @default(0)
  nextAttemptAt  DateTime  @default(now()) @db.Timestamptz(3)
  leaseUntil     DateTime? @db.Timestamptz(3)
  claimId        String?   @db.Uuid
  sentAt         DateTime? @db.Timestamptz(3)
  cancelledAt    DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  token          AuthToken @relation(fields: [tokenId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([sentAt, cancelledAt, nextAttemptAt])
  @@map("mail_deliveries")
}

// One row per ordered pair. PENDING is a request to a private profile;
// ACCEPTED grants access. Self-follow and the status/acceptedAt pairing are
// enforced by CHECK constraints in the migration SQL.
model Follow {
  followerId String       @db.Uuid
  followeeId String       @db.Uuid
  status     FollowStatus
  createdAt  DateTime     @default(now()) @db.Timestamptz(3)
  acceptedAt DateTime?    @db.Timestamptz(3)
  follower   User         @relation("follower", fields: [followerId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  followee   User         @relation("followee", fields: [followeeId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@id([followerId, followeeId])
  @@index([followeeId, status])
  @@index([followerId, status])
  @@map("follows")
}

// One uploaded image and its prepared variants in private storage. PENDING
// while files are written, READY once usable, DELETED when no longer served
// (files are then removed by a repeatable cleanup). CHECK constraints in SQL.
model Media {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId   String     @db.Uuid
  kind      MediaKind
  state     MediaState @default(PENDING)
  width     Int?
  height    Int?
  createdAt DateTime   @default(now()) @db.Timestamptz(3)
  deletedAt DateTime?  @db.Timestamptz(3)
  owner     User       @relation("owner", fields: [ownerId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  avatarOf  User?      @relation("avatar")
  post      Post?

  @@index([state, createdAt])
  @@index([ownerId])
  @@map("media")
}

// FR-04: exactly one image per post. Created only with READY media.
model Post {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authorId  String   @db.Uuid
  mediaId   String   @unique @db.Uuid
  caption   String   @default("") @db.VarChar(2200)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  media     Media    @relation(fields: [mediaId], references: [id], onDelete: NoAction, onUpdate: Restrict)
  likes     PostLike[]
  comments  Comment[]

  @@index([authorId, createdAt(sort: Desc), id(sort: Desc)])
  // Feed keyset over many authors.
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@map("posts")
}

// FR-06: at most one like per user and post (the primary key).
model PostLike {
  postId    String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@id([postId, userId])
  @@index([userId])
  @@map("post_likes")
}

model Comment {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  postId    String   @db.Uuid
  authorId  String   @db.Uuid
  text      String   @db.VarChar(2200)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([postId, createdAt, id])
  @@index([authorId])
  @@map("comments")
}
