generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum AuthTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum FollowStatus {
  PENDING
  ACCEPTED
}

enum MediaKind {
  DIRECT
  COMMENT
  STORY
  POST
  AVATAR
}

enum MediaState {
  PENDING
  READY
  DELETED
}

// FR-10: a post is a photo or a video; avatars are always images.
enum MediaType {
  AUDIO
  IMAGE
  VIDEO
}

model User {
  postShares PostShare[]
  storyShares StoryShare[]
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email             String          @db.VarChar(254)
  emailKey          String          @unique @db.VarChar(254)
  username          String          @db.VarChar(30)
  usernameKey       String          @unique @db.VarChar(30)
  passwordHash      String          @db.Text
  emailVerifiedAt   DateTime?       @db.Timestamptz(3)
  credentialVersion Int             @default(0)
  displayName       String          @default("") @db.VarChar(30)
  // Unicode lower case computed by the API: search must not depend on the
  // database collation ("C" folds only ASCII).
  displayNameKey    String          @default("") @db.Text
  bio               String          @default("") @db.VarChar(150)
  isPrivate         Boolean         @default(false)
  avatarMediaId     String?         @unique @db.Uuid
  createdAt         DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime        @default(now()) @updatedAt @db.Timestamptz(3)
  sessions          AuthSession[]
  tokens            AuthToken[]
  following         Follow[]        @relation("follower")
  followers         Follow[]        @relation("followee")
  avatar            Media?          @relation("avatar", fields: [avatarMediaId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  media             Media[]         @relation("owner")
  stories           Story[]
  storyViews        StoryView[]
  posts             Post[]
  likes             PostLike[]
  savedPosts        PostSave[]
  commentLikes      CommentLike[]
  addressedReplies  Comment[]       @relation("replyRecipient")
  comments          Comment[]
  notificationsReceived Notification[] @relation("notificationRecipient")
  notificationsActed Notification[] @relation("notificationActor")
  conversationsA    Conversation[]  @relation("participantA")
  conversationsB    Conversation[]  @relation("participantB")
  conversationsMade Conversation[]  @relation("creator")
  callsMade Call[] @relation("callCaller")
  callsReceived Call[] @relation("callCallee")
  callSeat CallSeat?
  lives Live[] @relation("liveHost")
  liveComments LiveComment[]
  liveGifts LiveGift[] @relation("liveGiftSender")
  liveModerators LiveModerator[] @relation("liveModeratorHost")
  liveModerating LiveModerator[] @relation("liveModeratorUser")
  liveRestrictions LiveRestriction[] @relation("liveRestrictionHost")
  liveRestricted LiveRestriction[] @relation("liveRestrictionUser")
  liveRestrictionsMade LiveRestriction[] @relation("liveRestrictionAuthor")
  messages          DirectMessage[]
  coinWallet        CoinWallet?
  coinsSent         CoinOperation[] @relation("coinSender")
  coinsReceived     CoinOperation[] @relation("coinRecipient")

  @@map("auth_users")
}

enum CoinOperationKind {
  DAILY_REWARD
  GIFT_TRANSFER
}

model CoinWallet {
  userId    String   @id @db.Uuid
  balance   BigInt   @default(0)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@map("coin_wallets")
}

// Immutable journal; account deletion needs an explicit retention policy.
model CoinOperation {
  id                    String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind                  CoinOperationKind
  senderId              String? @db.Uuid
  recipientId           String @db.Uuid
  amount                BigInt
  senderBalanceAfter    BigInt?
  recipientBalanceAfter BigInt
  claimDate             DateTime? @db.Date
  streamId              String? @db.Uuid
  giftKey               String? @db.VarChar(80)
  idempotencyKey        String? @db.Uuid
  createdAt             DateTime @default(now()) @db.Timestamptz(3)
  sender                User? @relation("coinSender", fields: [senderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  liveGift              LiveGift?
  recipient             User @relation("coinRecipient", fields: [recipientId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([recipientId, claimDate])
  @@unique([senderId, idempotencyKey])
  @@index([recipientId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([senderId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([streamId])
  @@map("coin_operations")
}

model AuthSession {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String    @db.Uuid
  tokenHash         String    @unique @db.VarChar(64)
  credentialVersion Int
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt         DateTime  @db.Timestamptz(3)
  revokedAt         DateTime? @db.Timestamptz(3)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model AuthToken {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String           @db.Uuid
  purpose           AuthTokenPurpose
  tokenHash         String           @unique @db.VarChar(64)
  credentialVersion Int
  createdAt         DateTime         @default(now()) @db.Timestamptz(3)
  expiresAt         DateTime         @db.Timestamptz(3)
  consumedAt        DateTime?        @db.Timestamptz(3)
  revokedAt         DateTime?        @db.Timestamptz(3)
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  delivery          MailDelivery?

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("auth_tokens")
}

model MailDelivery {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tokenId       String    @unique @db.Uuid
  payload       String?   @db.Text
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now()) @db.Timestamptz(3)
  leaseUntil    DateTime? @db.Timestamptz(3)
  claimId       String?   @db.Uuid
  sentAt        DateTime? @db.Timestamptz(3)
  cancelledAt   DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  token         AuthToken @relation(fields: [tokenId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([sentAt, cancelledAt, nextAttemptAt])
  @@map("mail_deliveries")
}

// One row per ordered pair. PENDING is a request to a private profile;
// ACCEPTED grants access. Self-follow and the status/acceptedAt pairing are
// enforced by CHECK constraints in the migration SQL.
model Follow {
  followerId String       @db.Uuid
  followeeId String       @db.Uuid
  status     FollowStatus
  createdAt  DateTime     @default(now()) @db.Timestamptz(3)
  acceptedAt DateTime?    @db.Timestamptz(3)
  follower   User         @relation("follower", fields: [followerId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  followee   User         @relation("followee", fields: [followeeId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@id([followerId, followeeId])
  @@index([followeeId, status])
  @@index([followerId, status])
  @@map("follows")
}

// One uploaded image and its prepared variants in private storage. PENDING
// while files are written, READY once usable, DELETED when no longer served
// (files are then removed by a repeatable cleanup). CHECK constraints in SQL.
model Media {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId    String     @db.Uuid
  kind       MediaKind
  type       MediaType  @default(IMAGE)
  state      MediaState @default(PENDING)
  width      Int?
  height     Int?
  // Video or voice: duration measured by the processing pipeline.
  durationMs Int?
  createdAt  DateTime   @default(now()) @db.Timestamptz(3)
  // A video whose processing failed stays PENDING with this set, so its
  // author can be told; cleanup removes it later.
  failedAt   DateTime?  @db.Timestamptz(3)
  deletedAt  DateTime?  @db.Timestamptz(3)
  owner      User       @relation("owner", fields: [ownerId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  avatarOf   User?      @relation("avatar")
  directMessage DirectMessage?
  comment    Comment?
  story      Story?
  post       Post?

  @@index([state, createdAt])
  @@index([ownerId])
  @@map("media")
}

// FR-04/FR-10: exactly one image or video per post. Photos are created with
// READY media; a video post is created PENDING and becomes visible when its
// media turns READY.
model Post {
  shares PostShare[]
  sharedMessages DirectMessage[] @relation("sharedPost")
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authorId  String     @db.Uuid
  mediaId   String     @unique @db.Uuid
  caption   String     @default("") @db.VarChar(2200)
  createdAt DateTime   @default(now()) @db.Timestamptz(3)
  author    User       @relation(fields: [authorId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  media     Media      @relation(fields: [mediaId], references: [id], onDelete: NoAction, onUpdate: Restrict)
  likes     PostLike[]
  saves     PostSave[]
  comments  Comment[]
  notifications Notification[]

  @@index([authorId, createdAt(sort: Desc), id(sort: Desc)])
  // Feed keyset over many authors.
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@map("posts")
}

// FR-06: at most one like per user and post (the primary key).
model PostLike {
  postId    String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@id([postId, userId])
  @@index([userId])
  @@map("post_likes")
}

// Saved posts ("Сохранённое"): one bookmark per user and post, private to the user.
model PostSave {
  postId    String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@id([postId, userId])
  @@index([userId])
  @@map("post_saves")
}

model Comment {
  mediaId String? @unique @db.Uuid
  media Media? @relation(fields: [mediaId], references: [id], onDelete: NoAction, onUpdate: Restrict)
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  postId    String   @db.Uuid
  authorId  String   @db.Uuid
  text      String   @db.VarChar(2200)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  parentId      String?       @db.Uuid
  replyToUserId String?       @db.Uuid
  parent        Comment?      @relation("commentReplies", fields: [parentId, postId], references: [id, postId], onDelete: Cascade, onUpdate: Restrict, map: "comments_parent_post_fkey")
  replies       Comment[]     @relation("commentReplies")
  replyTo       User?         @relation("replyRecipient", fields: [replyToUserId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  likes         CommentLike[]
  notifications Notification[]

  @@unique([id, postId])
  @@index([parentId, createdAt, id])
  @@index([postId, createdAt, id])
  @@index([authorId])
  @@map("comments")
}

// FR-09: one conversation per pair of users. The pair is stored ordered
// (userAId < userBId, CHECK in the migration) so the unique key covers both
// directions. lastActivityAt orders the list; it moves with each message.
model Conversation {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userAId        String          @db.Uuid
  userBId        String          @db.Uuid
  createdById    String          @db.Uuid
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  lastActivityAt DateTime        @default(now()) @db.Timestamptz(3)
  userA          User            @relation("participantA", fields: [userAId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  userB          User            @relation("participantB", fields: [userBId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  createdBy      User            @relation("creator", fields: [createdById], references: [id], onDelete: Cascade, onUpdate: Restrict)
  calls Call[]
  messages       DirectMessage[]

  @@unique([userAId, userBId])
  @@index([userAId, lastActivityAt(sort: Desc), id(sort: Desc)])
  @@index([userBId, lastActivityAt(sort: Desc), id(sort: Desc)])
  @@map("direct_conversations")
}

// A retry with the same (senderId, clientMessageId) finds the stored message
// instead of creating a duplicate.
model DirectMessage {
  sharedKind SharedContentKind?
  sharedTargetId String? @db.Uuid
  sharedPostId String? @db.Uuid
  sharedStoryId String? @db.Uuid
  sharedPost Post? @relation("sharedPost", fields: [sharedPostId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  sharedStory Story? @relation("sharedStory", fields: [sharedStoryId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  mediaId String? @unique @db.Uuid
  sourceHash String? @db.VarChar(64)
  media Media? @relation(fields: [mediaId], references: [id], onDelete: NoAction, onUpdate: Restrict)
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId  String       @db.Uuid
  senderId        String       @db.Uuid
  clientMessageId String       @db.Uuid
  text            String       @db.VarChar(1000)
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  sender          User         @relation(fields: [senderId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([senderId, clientMessageId])
  @@index([conversationId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([sharedPostId])
  @@index([sharedStoryId])
  @@map("direct_messages")
}

model CommentLike {
  commentId String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@id([commentId, userId])
  @@index([userId])
  @@map("comment_likes")
}

enum NotificationKind {
  POST_LIKE
  COMMENT
  REPLY
  COMMENT_LIKE
}

// A journal of interaction notifications. The unique key makes repeated likes
// idempotent; source deletion cascades away notifications with stale links.
model Notification {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String           @unique @db.VarChar(120)
  kind        NotificationKind
  recipientId String           @db.Uuid
  actorId     String           @db.Uuid
  postId      String           @db.Uuid
  commentId   String?          @db.Uuid
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  recipient   User             @relation("notificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  actor       User             @relation("notificationActor", fields: [actorId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  post        Post             @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  comment     Comment?         @relation(fields: [commentId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([recipientId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([postId])
  @@index([commentId])
  @@map("notifications")
}

enum CallStatus {
  RINGING
  ACTIVE
  ENDED
  DECLINED
  MISSED
  FAILED
}
enum CallKind {
  AUDIO
  VIDEO
}
model Call {
  id String @id @db.Uuid
  conversationId String @db.Uuid
  callerId String @db.Uuid
  calleeId String @db.Uuid
  callerSessionHash String @db.VarChar(64)
  calleeSessionHash String? @db.VarChar(64)
  callerClientId String @db.Uuid
  calleeClientId String? @db.Uuid
  kind CallKind
  status CallStatus @default(RINGING)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  answeredAt DateTime? @db.Timestamptz(3)
  endedAt DateTime? @db.Timestamptz(3)
  callerSeenAt DateTime @default(now()) @db.Timestamptz(3)
  calleeSeenAt DateTime? @db.Timestamptz(3)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  caller User @relation("callCaller", fields: [callerId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  callee User @relation("callCallee", fields: [calleeId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  seats CallSeat[]
  @@index([conversationId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([status, createdAt])
  @@map("calls")
}
model CallSeat {
  userId String @id @db.Uuid
  callId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  call Call @relation(fields: [callId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  @@index([callId])
  @@map("call_seats")
}

// FR-12 live streams (stage 10). Media goes from the host browser straight
// to the viewers; only the state and, while on air, the chat are stored.
enum LiveStatus {
  LIVE
  ENDED
}
enum LiveEndReason {
  HOST
  LOST
  SIGNED_OUT
  TIME_LIMIT
}
model Live {
  id String @id @db.Uuid
  hostId String @db.Uuid
  // The host id while LIVE and NULL after it: one live per host at a time
  // (NULLs are distinct in a PostgreSQL unique index).
  activeHostId String? @unique @db.Uuid
  hostSessionHash String @db.VarChar(64)
  hostClientId String @db.Uuid
  status LiveStatus @default(LIVE)
  endReason LiveEndReason?
  startedAt DateTime @default(now()) @db.Timestamptz(3)
  endedAt DateTime? @db.Timestamptz(3)
  hostSeenAt DateTime @default(now()) @db.Timestamptz(3)
  host User @relation("liveHost", fields: [hostId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  comments LiveComment[]
  gifts LiveGift[]
  @@index([status, startedAt])
  @@index([hostId, startedAt(sort: Desc)])
  @@map("lives")
}
model LiveComment {
  id String @id @db.Uuid
  liveId String @db.Uuid
  authorId String @db.Uuid
  text String @db.VarChar(300)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  live Live @relation(fields: [liveId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  @@index([liveId, createdAt, id])
  @@index([authorId])
  @@map("live_comments")
}

// FR-13: expiry is checked on every read, independently of background cleanup.
model Story {
  shares StoryShare[]
  sharedMessages DirectMessage[] @relation("sharedStory")
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authorId  String      @db.Uuid
  mediaId   String      @unique @db.Uuid
  createdAt DateTime    @default(now()) @db.Timestamptz(3)
  expiresAt DateTime    @default(dbgenerated("(CURRENT_TIMESTAMP + '24:00:00'::interval)")) @db.Timestamptz(3)
  author    User        @relation(fields: [authorId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  media     Media       @relation(fields: [mediaId], references: [id], onDelete: NoAction, onUpdate: Restrict)
  views     StoryView[]

  @@index([authorId, createdAt, id])
  @@index([expiresAt])
  @@map("stories")
}

model StoryView {
  storyId String   @db.Uuid
  userId  String   @db.Uuid
  viewedAt DateTime @default(now()) @db.Timestamptz(3)
  story   Story    @relation(fields: [storyId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@id([storyId, userId])
  @@index([storyId, viewedAt(sort: Desc), userId(sort: Desc)])
  @@index([userId])
  @@map("story_views")
}

// FR-14 gift shown in a live stream. Its id is the coin operation that moved
// the price from the sender to the host in the same transaction.
model LiveGift {
  id String @id @db.Uuid
  liveId String @db.Uuid
  senderId String @db.Uuid
  idempotencyKey String @db.Uuid
  giftKey String @db.VarChar(80)
  price Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  operation CoinOperation @relation(fields: [id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  live Live @relation(fields: [liveId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  sender User @relation("liveGiftSender", fields: [senderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@unique([senderId, idempotencyKey])
  @@index([liveId, createdAt, id])
  @@map("live_gifts")
}

// Moderation of all live streams of a host: moderators chosen by the host
// and restrictions of users (MUTE until a time or for good, BAN for good).
enum LiveRestrictionKind {
  MUTE
  BAN
}
model LiveModerator {
  hostId String @db.Uuid
  userId String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  host User @relation("liveModeratorHost", fields: [hostId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  user User @relation("liveModeratorUser", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  @@id([hostId, userId])
  @@index([userId])
  @@map("live_moderators")
}
model LiveRestriction {
  hostId String @db.Uuid
  userId String @db.Uuid
  kind LiveRestrictionKind
  // NULL: for good.
  until DateTime? @db.Timestamptz(3)
  createdById String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  host User @relation("liveRestrictionHost", fields: [hostId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  user User @relation("liveRestrictionUser", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  createdBy User @relation("liveRestrictionAuthor", fields: [createdById], references: [id], onDelete: Cascade, onUpdate: Restrict)
  @@id([hostId, userId, kind])
  @@index([userId, kind])
  @@map("live_restrictions")
}

// Direct owns the durable unique-sharer journal; product modules read its count.
enum SharedContentKind {
  POST
  REEL
  STORY
}
model PostShare {
  postId String @db.Uuid
  userId String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  @@id([postId, userId])
  @@index([userId])
  @@map("post_shares")
}
model StoryShare {
  storyId String @db.Uuid
  userId String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  @@id([storyId, userId])
  @@index([userId])
  @@map("story_shares")
}
