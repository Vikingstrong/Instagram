generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum AuthTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum FollowStatus {
  PENDING
  ACCEPTED
}

enum MediaKind {
  STORY
  POST
  AVATAR
}

enum MediaState {
  PENDING
  READY
  DELETED
}

// FR-10: a post is a photo or a video; avatars are always images.
enum MediaType {
  IMAGE
  VIDEO
}

model User {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email             String          @db.VarChar(254)
  emailKey          String          @unique @db.VarChar(254)
  username          String          @db.VarChar(30)
  usernameKey       String          @unique @db.VarChar(30)
  passwordHash      String          @db.Text
  emailVerifiedAt   DateTime?       @db.Timestamptz(3)
  credentialVersion Int             @default(0)
  displayName       String          @default("") @db.VarChar(30)
  // Unicode lower case computed by the API: search must not depend on the
  // database collation ("C" folds only ASCII).
  displayNameKey    String          @default("") @db.Text
  bio               String          @default("") @db.VarChar(150)
  isPrivate         Boolean         @default(false)
  avatarMediaId     String?         @unique @db.Uuid
  createdAt         DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime        @default(now()) @updatedAt @db.Timestamptz(3)
  sessions          AuthSession[]
  tokens            AuthToken[]
  following         Follow[]        @relation("follower")
  followers         Follow[]        @relation("followee")
  avatar            Media?          @relation("avatar", fields: [avatarMediaId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  media             Media[]         @relation("owner")
  stories           Story[]
  storyViews        StoryView[]
  posts             Post[]
  likes             PostLike[]
  commentLikes      CommentLike[]
  addressedReplies  Comment[]       @relation("replyRecipient")
  comments          Comment[]
  conversationsA    Conversation[]  @relation("participantA")
  conversationsB    Conversation[]  @relation("participantB")
  conversationsMade Conversation[]  @relation("creator")
  callsMade Call[] @relation("callCaller")
  callsReceived Call[] @relation("callCallee")
  callSeat CallSeat?
  messages          DirectMessage[]
  coinWallet        CoinWallet?
  coinsSent         CoinOperation[] @relation("coinSender")
  coinsReceived     CoinOperation[] @relation("coinRecipient")

  @@map("auth_users")
}

enum CoinOperationKind {
  DAILY_REWARD
  GIFT_TRANSFER
}

model CoinWallet {
  userId    String   @id @db.Uuid
  balance   BigInt   @default(0)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@map("coin_wallets")
}

// Immutable journal; account deletion needs an explicit retention policy.
model CoinOperation {
  id                    String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind                  CoinOperationKind
  senderId              String? @db.Uuid
  recipientId           String @db.Uuid
  amount                BigInt
  senderBalanceAfter    BigInt?
  recipientBalanceAfter BigInt
  claimDate             DateTime? @db.Date
  streamId              String? @db.Uuid
  giftKey               String? @db.VarChar(80)
  idempotencyKey        String? @db.Uuid
  createdAt             DateTime @default(now()) @db.Timestamptz(3)
  sender                User? @relation("coinSender", fields: [senderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  recipient             User @relation("coinRecipient", fields: [recipientId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([recipientId, claimDate])
  @@unique([senderId, idempotencyKey])
  @@index([recipientId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([senderId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([streamId])
  @@map("coin_operations")
}

model AuthSession {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String    @db.Uuid
  tokenHash         String    @unique @db.VarChar(64)
  credentialVersion Int
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt         DateTime  @db.Timestamptz(3)
  revokedAt         DateTime? @db.Timestamptz(3)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model AuthToken {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String           @db.Uuid
  purpose           AuthTokenPurpose
  tokenHash         String           @unique @db.VarChar(64)
  credentialVersion Int
  createdAt         DateTime         @default(now()) @db.Timestamptz(3)
  expiresAt         DateTime         @db.Timestamptz(3)
  consumedAt        DateTime?        @db.Timestamptz(3)
  revokedAt         DateTime?        @db.Timestamptz(3)
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  delivery          MailDelivery?

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("auth_tokens")
}

model MailDelivery {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tokenId       String    @unique @db.Uuid
  payload       String?   @db.Text
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now()) @db.Timestamptz(3)
  leaseUntil    DateTime? @db.Timestamptz(3)
  claimId       String?   @db.Uuid
  sentAt        DateTime? @db.Timestamptz(3)
  cancelledAt   DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  token         AuthToken @relation(fields: [tokenId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([sentAt, cancelledAt, nextAttemptAt])
  @@map("mail_deliveries")
}

// One row per ordered pair. PENDING is a request to a private profile;
// ACCEPTED grants access. Self-follow and the status/acceptedAt pairing are
// enforced by CHECK constraints in the migration SQL.
model Follow {
  followerId String       @db.Uuid
  followeeId String       @db.Uuid
  status     FollowStatus
  createdAt  DateTime     @default(now()) @db.Timestamptz(3)
  acceptedAt DateTime?    @db.Timestamptz(3)
  follower   User         @relation("follower", fields: [followerId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  followee   User         @relation("followee", fields: [followeeId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@id([followerId, followeeId])
  @@index([followeeId, status])
  @@index([followerId, status])
  @@map("follows")
}

// One uploaded image and its prepared variants in private storage. PENDING
// while files are written, READY once usable, DELETED when no longer served
// (files are then removed by a repeatable cleanup). CHECK constraints in SQL.
model Media {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId    String     @db.Uuid
  kind       MediaKind
  type       MediaType  @default(IMAGE)
  state      MediaState @default(PENDING)
  width      Int?
  height     Int?
  // Video only: duration of the transcoded file.
  durationMs Int?
  createdAt  DateTime   @default(now()) @db.Timestamptz(3)
  // A video whose processing failed stays PENDING with this set, so its
  // author can be told; cleanup removes it later.
  failedAt   DateTime?  @db.Timestamptz(3)
  deletedAt  DateTime?  @db.Timestamptz(3)
  owner      User       @relation("owner", fields: [ownerId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  avatarOf   User?      @relation("avatar")
  story      Story?
  post       Post?

  @@index([state, createdAt])
  @@index([ownerId])
  @@map("media")
}

// FR-04/FR-10: exactly one image or video per post. Photos are created with
// READY media; a video post is created PENDING and becomes visible when its
// media turns READY.
model Post {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authorId  String     @db.Uuid
  mediaId   String     @unique @db.Uuid
  caption   String     @default("") @db.VarChar(2200)
  createdAt DateTime   @default(now()) @db.Timestamptz(3)
  author    User       @relation(fields: [authorId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  media     Media      @relation(fields: [mediaId], references: [id], onDelete: NoAction, onUpdate: Restrict)
  likes     PostLike[]
  comments  Comment[]

  @@index([authorId, createdAt(sort: Desc), id(sort: Desc)])
  // Feed keyset over many authors.
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@map("posts")
}

// FR-06: at most one like per user and post (the primary key).
model PostLike {
  postId    String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@id([postId, userId])
  @@index([userId])
  @@map("post_likes")
}

model Comment {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  postId    String   @db.Uuid
  authorId  String   @db.Uuid
  text      String   @db.VarChar(2200)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  parentId      String?       @db.Uuid
  replyToUserId String?       @db.Uuid
  parent        Comment?      @relation("commentReplies", fields: [parentId, postId], references: [id, postId], onDelete: Cascade, onUpdate: Restrict, map: "comments_parent_post_fkey")
  replies       Comment[]     @relation("commentReplies")
  replyTo       User?         @relation("replyRecipient", fields: [replyToUserId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  likes         CommentLike[]

  @@unique([id, postId])
  @@index([parentId, createdAt, id])
  @@index([postId, createdAt, id])
  @@index([authorId])
  @@map("comments")
}

// FR-09: one conversation per pair of users. The pair is stored ordered
// (userAId < userBId, CHECK in the migration) so the unique key covers both
// directions. lastActivityAt orders the list; it moves with each message.
model Conversation {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userAId        String          @db.Uuid
  userBId        String          @db.Uuid
  createdById    String          @db.Uuid
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  lastActivityAt DateTime        @default(now()) @db.Timestamptz(3)
  userA          User            @relation("participantA", fields: [userAId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  userB          User            @relation("participantB", fields: [userBId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  createdBy      User            @relation("creator", fields: [createdById], references: [id], onDelete: Cascade, onUpdate: Restrict)
  calls Call[]
  messages       DirectMessage[]

  @@unique([userAId, userBId])
  @@index([userAId, lastActivityAt(sort: Desc), id(sort: Desc)])
  @@index([userBId, lastActivityAt(sort: Desc), id(sort: Desc)])
  @@map("direct_conversations")
}

// A retry with the same (senderId, clientMessageId) finds the stored message
// instead of creating a duplicate.
model DirectMessage {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId  String       @db.Uuid
  senderId        String       @db.Uuid
  clientMessageId String       @db.Uuid
  text            String       @db.VarChar(1000)
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  sender          User         @relation(fields: [senderId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([senderId, clientMessageId])
  @@index([conversationId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("direct_messages")
}

model CommentLike {
  commentId String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@id([commentId, userId])
  @@index([userId])
  @@map("comment_likes")
}

enum CallStatus {
  RINGING
  ACTIVE
  ENDED
  DECLINED
  MISSED
  FAILED
}
enum CallKind {
  AUDIO
  VIDEO
}
model Call {
  id String @id @db.Uuid
  conversationId String @db.Uuid
  callerId String @db.Uuid
  calleeId String @db.Uuid
  callerSessionHash String @db.VarChar(64)
  calleeSessionHash String? @db.VarChar(64)
  callerClientId String @db.Uuid
  calleeClientId String? @db.Uuid
  kind CallKind
  status CallStatus @default(RINGING)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  answeredAt DateTime? @db.Timestamptz(3)
  endedAt DateTime? @db.Timestamptz(3)
  callerSeenAt DateTime @default(now()) @db.Timestamptz(3)
  calleeSeenAt DateTime? @db.Timestamptz(3)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  caller User @relation("callCaller", fields: [callerId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  callee User @relation("callCallee", fields: [calleeId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  seats CallSeat[]
  @@index([conversationId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([status, createdAt])
  @@map("calls")
}
model CallSeat {
  userId String @id @db.Uuid
  callId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  call Call @relation(fields: [callId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  @@index([callId])
  @@map("call_seats")
}

// FR-13: expiry is checked on every read, independently of background cleanup.
model Story {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authorId  String      @db.Uuid
  mediaId   String      @unique @db.Uuid
  createdAt DateTime    @default(now()) @db.Timestamptz(3)
  expiresAt DateTime    @default(dbgenerated("(CURRENT_TIMESTAMP + '24:00:00'::interval)")) @db.Timestamptz(3)
  author    User        @relation(fields: [authorId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  media     Media       @relation(fields: [mediaId], references: [id], onDelete: NoAction, onUpdate: Restrict)
  views     StoryView[]

  @@index([authorId, createdAt, id])
  @@index([expiresAt])
  @@map("stories")
}

model StoryView {
  storyId String   @db.Uuid
  userId  String   @db.Uuid
  viewedAt DateTime @default(now()) @db.Timestamptz(3)
  story   Story    @relation(fields: [storyId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@id([storyId, userId])
  @@index([storyId, viewedAt(sort: Desc), userId(sort: Desc)])
  @@index([userId])
  @@map("story_views")
}
