{
  "name": "instagram",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter @instagram/contracts build && pnpm --filter @instagram/web dev",
    "dev:api": "pnpm --filter @instagram/contracts build && pnpm --filter @instagram/api start:dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e"
  },
  "devDependencies": {
    "turbo": "^2.11.9"
  }
}
