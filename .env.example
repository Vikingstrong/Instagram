# Local development only. Copy to .env at the repository root.
# Replace every placeholder; URL-encode passwords in the connection URLs.
POSTGRES_ADMIN_PASSWORD=REPLACE_WITH_LOCAL_ADMIN_PASSWORD
POSTGRES_DEV_PASSWORD=REPLACE_WITH_LOCAL_DEV_PASSWORD
POSTGRES_TEST_PASSWORD=REPLACE_WITH_LOCAL_TEST_PASSWORD
POSTGRES_PORT=5432
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
DATABASE_URL=postgresql://instagram_dev:REPLACE_WITH_LOCAL_DEV_PASSWORD@127.0.0.1:5432/instagram_dev
TEST_DATABASE_URL=postgresql://instagram_test:REPLACE_WITH_LOCAL_TEST_PASSWORD@127.0.0.1:5432/instagram_test

# Auth server configuration. Dev defaults need no additional secrets.
# Production requires NODE_ENV=production, an HTTPS origin and a random 32-byte
# lowercase-hex signing secret from your secret manager. Never commit its value.
# AUTH_PUBLIC_ORIGIN=http://localhost:3000
# AUTH_CSRF_SECRET=REPLACE_WITH_64_LOWERCASE_HEX_CHARACTERS

# Required for registration and email actions: persistent AES-256-GCM outbox key.
# Generate 32 random bytes as lowercase hex; preserve across API restarts.
# MAIL_OUTBOX_KEY=REPLACE_WITH_64_LOWERCASE_HEX_CHARACTERS
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=noreply@example.test
SMTP_SECURE=false
# Production SMTP requires TLS (implicit TLS when SMTP_SECURE=true, STARTTLS otherwise).
# SMTP_USER=REPLACE_WITH_SMTP_USERNAME
# SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
# MAIL_WORKER_ENABLED=true
